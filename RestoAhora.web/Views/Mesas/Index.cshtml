@using Domain.Entities
@using Domain.Enums
@model IEnumerable<Mesa>

@{
    ViewData["Title"] = "Listado de Mesas";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Gestión de Mesas</h2>
    <a asp-action="Crear" class="btn btn-primary">➕ Nueva Mesa</a>
</div>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Número</th>
            <th>Capacidad</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var mesa in Model)
        {
            <tr>
                <td>Mesa #@mesa.Numero</td>
                <td>@mesa.Capacidad personas</td>
                <td>
                    <span class="badge @(mesa.Estado == EstadoMesa.disponible ? "bg-success" : "bg-danger")">
                        @mesa.Estado
                    </span>
                </td>
                <td>
                    <a asp-action="Editar" asp-route-id="@mesa.Id" class="btn btn-sm btn-warning">✏️ Editar</a>
                </td>
                <td>
                    <a asp-action="Eliminar" asp-route-id="@mesa.Id" class="btn btn-sm btn-danger">🗑️ Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>